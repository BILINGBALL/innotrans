PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
PG_SSL=false
ADMIN_PASSWORD=innotrans-admin
JWT_SECRET=please-change-me
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY=your-access-key
OSS_ACCESS_SECRET=your-access-secret
OSS_BUCKET=your-bucket

# 邮件服务（阿里云企业邮箱示例）
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@your-domain.com
SMTP_PASS=your-smtp-password

# 邮件打开追踪的公网地址（可选，留空则不做追踪）
APP_BASE_URL=

# 火山引擎豆包语音识别（流式大模型 2.0，鉴权只需 App ID + Access Token；Secret Key 暂不使用）
VOLC_ASR_APP_ID=your-app-id
VOLC_ASR_ACCESS_TOKEN=your-access-token
VOLC_ASR_SECRET_KEY=your-secret-key
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
